# Bỏ trống GEMINI_API_KEY = chạy chế độ giả lập (để thử giao diện).
# Key phải bật billing — free tier quá thấp cho làm theo lô.
GEMINI_API_KEY=

# Mặc định: SQLite trong UPLOAD_DIR. Dùng Postgres: postgresql+psycopg://user:pass@host/db
DATABASE_URL=
UPLOAD_DIR=./data

TEXT_MODEL=gemini-2.5-flash
IMAGE_MODEL=gemini-2.5-flash-image

# Sinh ảnh bằng ChatGPT (tuỳ chọn). Trống = lựa chọn ChatGPT báo "chưa có key".
# Tổ chức OpenAI phải được xác minh (Organization verification) mới gọi được gpt-image.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# low | medium | high | auto — high đẹp nhất nhưng đắt và chậm nhất
OPENAI_IMAGE_QUALITY=high

HOST=127.0.0.1
PORT=7860
# MOCK_GEMINI=1
